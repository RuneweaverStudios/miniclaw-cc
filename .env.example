# MiniClaw-CC Development Environment Variables
# Copy this file to .env.local and fill in your values

# Application
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL Configuration
DATABASE_URL=postgresql://miniclaw:miniclaw@localhost:5432/miniclaw_dev

# DigitalOcean Configuration
# Get your token: https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_TOKEN=do_pat_token_here

# Cloudflare Configuration
CLOUDFLARE_TOKEN=
CLOUDFLARE_ZONE=

# Stripe Configuration (Test Mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# JWT Configuration
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRY=7d

# OAuth Providers (Development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@localhost

# SSH Configuration
SSH_PRIVATE_KEY_PATH=/Users/ghost-m4/.ssh/id_ed25519

# Pool Configuration (Development)
POOL_TARGET_SIZE=2
POOL_MIN_SIZE=1
POOL_MAX_SIZE=5
POOL_HEALTH_CHECK_INTERVAL=60000

# Worker Configuration
WORKER_CONCURRENT_JOBS=2

# Frontend URL
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# Domain Configuration
DOMAIN=localhost
SUBDOMAIN_DOMAIN=
